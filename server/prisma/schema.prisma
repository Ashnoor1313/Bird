datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses UserBusiness[]
}

model Business {
  id             String   @id @default(uuid())
  name           String
  logo           String?
  address        String?
  phone          String?
  email          String?
  gstin          String?
  state          String?  @default("Delhi")
  billPrefix     String   @default("BIRD")
  startingBillNo Int      @default(1001)
  bankName       String?
  accountNo      String?
  ifscCode       String?
  upiId          String?
  allowNegativeStock Boolean  @default(false)
  terms          String?  @default("Goods once sold will not be taken back unless defective under warranty testing.")
  createdAt      DateTime @default(now())

  users          UserBusiness[]
  categories     Category[]
  products       Product[]
  customers      Customer[]
  suppliers      Supplier[]
  sales          Sale[]
  purchases      Purchase[]
  payments       Payment[]
  expenses       Expense[]
  stockMovements StockMovement[]
  warehouses     Warehouse[]
  locations      Location[]
  locationStocks LocationStock[]
  accountBalances AccountBalance[]
  auditLogs      AuditLog[]
}

model UserBusiness {
  userId     String
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
}

model Category {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  description String?
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]
}

model Warehouse {
  id         String   @id @default(uuid())
  businessId String
  name       String
  location   String?
  isDefault  Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Location {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  type        String   @default("STORE") // GODOWN, STORE, WAREHOUSE, OTHER
  address     String?
  phone       String?
  managerName String?
  isDefault   Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationStocks LocationStock[]
  sales          Sale[]
  purchases      Purchase[]
  expenses       Expense[]
  customers      Customer[]
  suppliers      Supplier[]
  payments       Payment[]
  accountBalances AccountBalance[]
  movementsFrom  StockMovement[] @relation("FromLocation")
  movementsTo    StockMovement[] @relation("ToLocation")
}

model LocationStock {
  id             String   @id @default(uuid())
  businessId     String
  locationId     String
  productId      String
  goodStock      Int      @default(0)
  defectiveStock Int      @default(0)
  testingStock   Int      @default(0)
  reservedStock  Int      @default(0)
  quantity       Int      @default(0)
  minStock       Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([businessId, locationId, productId])
  @@index([businessId, locationId])
  @@index([businessId, productId])
  @@index([locationId, productId])
}

model Product {
  id             String   @id @default(uuid())
  businessId     String
  categoryId     String?
  name           String
  brand          String?
  model          String?
  partType       String?  // Display, Folder, Battery, Charging Port, IC, Camera, etc.
  variant        String?  // With Frame, Without Frame, Black, White, etc.
  quality        String   @default("OEM") // Original, OEM, Compatible, Copy, Refurbished
  unit           String   @default("PCS")
  sku            String?
  aliases        String?  // Alternate names/synonyms (e.g. "A15 LCD, Samsung A15 LCD, A15 Screen")
  itemCode       String?
  barcode        String?
  hsn            String?  @default("8517")
  gstPercentage  Float    @default(18.0)
  purchasePrice  Float    @default(0.0)
  sellingPrice   Float    @default(0.0)
  repairShopPrice Float?   @default(0.0)
  dealerPrice    Float?   @default(0.0)
  wholesalePrice Float?   @default(0.0)
  mrp            Float?   @default(0.0)
  currentStock   Int      @default(0)
  minStock       Int      @default(5)
  goodStock      Int      @default(0)
  defectiveStock Int      @default(0)
  testingStock   Int      @default(0)
  warranty       String?  @default("7 Days Testing")
  description    String?
  imageUrl       String?
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  locationStocks LocationStock[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@index([businessId, categoryId, status])
  @@index([businessId, brand, model])
  @@index([businessId, status, createdAt])
  @@index([businessId, name])
}

model StockMovement {
  id                     String   @id @default(uuid())
  businessId             String
  productId              String
  categoryId             String?  @default("folders")
  fromLocationId         String?
  toLocationId           String?
  type                   String   // OPENING, PURCHASE, SALE, CUSTOMER_RETURN, PURCHASE_RETURN, DAMAGED, MANUAL_ADJUSTMENT, TRANSFER
  quantity               Int
  previousStock          Int
  newStock               Int
  previousSourceQuantity Int?
  newSourceQuantity      Int?
  previousDestQuantity   Int?
  newDestQuantity        Int?
  stockState             String   @default("GOOD") // GOOD, DEFECTIVE, TESTING
  reference              String?  // BILL-1042, PUR-201, TR-101, etc.
  note                   String?
  createdBy              String?
  createdAt              DateTime @default(now())

  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromLocation Location? @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location? @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@index([businessId, categoryId, createdAt])
  @@index([businessId, productId, createdAt])
  @@index([businessId, type, createdAt])
}

model Customer {
  id             String   @id @default(uuid())
  businessId     String
  locationId     String
  categoryId     String   @default("folders")
  name           String
  phone          String?
  email          String?
  address        String?
  gstin          String?
  state          String?  @default("Delhi")
  priceLevel     String   @default("RETAIL") // RETAIL, REPAIR_SHOP, DEALER, WHOLESALE
  moneyToReceive Float    @default(0.0)
  totalSales     Float    @default(0.0)
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sales    Sale[]
  ledgers  CustomerLedger[]
  payments Payment[]

  @@unique([locationId, categoryId, phone])
  @@index([businessId, locationId, categoryId, createdAt])
  @@index([businessId, locationId, categoryId, phone])
  @@index([businessId, name])
  @@index([businessId, phone])
}

model Supplier {
  id             String   @id @default(uuid())
  businessId     String
  locationId     String
  name           String
  phone          String?
  email          String?
  address        String?
  gstin          String?
  state          String?  @default("Delhi")
  moneyToPay     Float    @default(0.0)
  totalPurchases Float    @default(0.0)
  createdAt      DateTime @default(now())

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  ledgers   SupplierLedger[]
  payments  Payment[]

  @@unique([locationId, phone])
  @@index([businessId, locationId, createdAt])
  @@index([businessId, locationId, phone])
  @@index([businessId, name])
  @@index([businessId, phone])
}

model CustomerLedger {
  id           String   @id @default(uuid())
  businessId   String
  locationId   String
  customerId   String
  type         String   // BILL (+), PAYMENT (-), RETURN (-)
  reference    String   // BILL-1042, PAY-201
  amount       Float
  balanceAfter Float
  note         String?
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, locationId, customerId, createdAt])
  @@index([customerId, createdAt])
}

model SupplierLedger {
  id           String   @id @default(uuid())
  businessId   String
  locationId   String
  supplierId   String
  type         String   // PURCHASE (+), PAYMENT (-), RETURN (-)
  reference    String   // PUR-201, PAY-102
  amount       Float
  balanceAfter Float
  note         String?
  createdAt    DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([businessId, locationId, supplierId, createdAt])
  @@index([supplierId, createdAt])
}

model Sale {
  id            String   @id @default(uuid())
  businessId    String
  locationId    String
  categoryId    String   @default("folders")
  billNo        String
  customerId    String?
  customerName  String
  customerPhone String?
  saleDate      DateTime @default(now())
  subtotal      Float
  discount      Float    @default(0.0)
  cgst          Float    @default(0.0)
  sgst          Float    @default(0.0)
  igst          Float    @default(0.0)
  total         Float
  totalCost     Float    @default(0.0)
  grossProfit   Float    @default(0.0)
  paidAmount    Float    @default(0.0)
  dueAmount     Float    @default(0.0)
  paymentMethod String   @default("CASH") // CASH, UPI, BANK, PARTIAL
  notes         String?
  status        String   @default("COMPLETED") // COMPLETED, CANCELLED
  createdAt     DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]

  @@unique([locationId, categoryId, billNo])
  @@index([businessId, locationId, categoryId, createdAt])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, billNo])
  @@index([businessId, createdAt])
}

model SaleItem {
  id            String  @id @default(uuid())
  saleId        String
  productId     String?
  productName   String
  model         String?
  quality       String?
  variant       String?
  quantity      Int
  unitPrice     Float
  purchasePrice Float   @default(0.0)
  discount      Float   @default(0.0)
  gstPercentage Float   @default(18.0)
  cgst          Float   @default(0.0)
  sgst          Float   @default(0.0)
  igst          Float   @default(0.0)
  total         Float
  warrantyDays  String? @default("7 Days Testing")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model Purchase {
  id                  String   @id @default(uuid())
  businessId          String
  receivingLocationId String
  categoryId          String?  @default("folders")
  purchaseNo          String
  supplierId          String?
  supplierName        String
  billNo              String?  // Supplier invoice number
  purchaseDate        DateTime @default(now())
  ocrScanned          Boolean  @default(false)
  imagePath           String?
  subtotal            Float
  discount            Float    @default(0.0)
  cgst                Float    @default(0.0)
  sgst                Float    @default(0.0)
  igst                Float    @default(0.0)
  total               Float
  paidAmount          Float    @default(0.0)
  dueAmount           Float    @default(0.0)
  paymentMethod       String   @default("CASH")
  notes               String?
  status              String   @default("COMPLETED") // COMPLETED, CANCELLED
  createdAt           DateTime @default(now())

  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  receivingLocation Location @relation(fields: [receivingLocationId], references: [id], onDelete: Cascade)
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items             PurchaseItem[]

  @@index([businessId, receivingLocationId, categoryId, createdAt])
  @@index([businessId, supplierId, createdAt])
  @@index([businessId, purchaseNo])
}

model PurchaseItem {
  id            String  @id @default(uuid())
  purchaseId    String
  productId     String?
  productName   String
  model         String?
  quality       String?
  variant       String?
  quantity      Int
  unitPrice     Float
  discount      Float   @default(0.0)
  gstPercentage Float   @default(18.0)
  cgst          Float   @default(0.0)
  sgst          Float   @default(0.0)
  igst          Float   @default(0.0)
  total         Float

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

model Payment {
  id            String   @id @default(uuid())
  businessId    String
  locationId    String
  categoryId    String?  @default("folders")
  type          String   // RECEIVE, PAY
  partyType     String   // CUSTOMER, SUPPLIER, EXPENSE
  customerId    String?
  supplierId    String?
  partyName     String
  amount        Float
  paymentMethod String   @default("CASH") // CASH, UPI, BANK, CARD, CHEQUE
  reference     String?
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([businessId, locationId, categoryId, createdAt])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, supplierId, createdAt])
  @@index([businessId, type, createdAt])
}

model Expense {
  id          String   @id @default(uuid())
  businessId  String
  locationId  String
  categoryId  String?  // Optional: null if general store expense, 'folders' or 'batteries' if category-specific
  category    String   // Rent, Electricity, Salary, Transport, Packaging, Repair, Marketing, Office, Other
  amount      Float
  paidFrom    String   @default("CASH") // CASH, BANK, UPI
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([businessId, locationId, categoryId, createdAt])
  @@index([businessId, category, createdAt])
}

model AccountBalance {
  id          String   @id @default(uuid())
  businessId  String
  locationId  String?
  cashBalance Float    @default(0.0)
  bankBalance Float    @default(0.0)
  upiBalance  Float    @default(0.0)
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([businessId, locationId])
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String
  details    String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Quotation {
  id            String   @id @default(uuid())
  businessId    String
  locationId    String?
  quoteNo       String
  customerId    String?
  customerName  String
  customerPhone String?
  quoteDate     DateTime @default(now())
  validUntil    DateTime?
  subtotal      Float
  discount      Float    @default(0.0)
  cgst          Float    @default(0.0)
  sgst          Float    @default(0.0)
  igst          Float    @default(0.0)
  total         Float
  notes         String?
  status        String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, CONVERTED, CANCELLED
  createdAt     DateTime @default(now())

  items QuotationItem[]
}

model QuotationItem {
  id            String  @id @default(uuid())
  quotationId   String
  productId     String?
  productName   String
  model         String?
  quality       String?
  variant       String?
  quantity      Int
  unitPrice     Float
  discount      Float   @default(0.0)
  gstPercentage Float   @default(18.0)
  total         Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id            String   @id @default(uuid())
  businessId    String
  locationId    String?
  orderNo       String
  customerId    String?
  customerName  String
  customerPhone String?
  orderDate     DateTime @default(now())
  subtotal      Float
  discount      Float    @default(0.0)
  cgst          Float    @default(0.0)
  sgst          Float    @default(0.0)
  igst          Float    @default(0.0)
  total         Float
  advancePaid   Float    @default(0.0)
  status        String   @default("CONFIRMED") // CONFIRMED, PARTIAL, COMPLETED, CANCELLED
  notes         String?
  createdAt     DateTime @default(now())

  items SalesOrderItem[]
}

model SalesOrderItem {
  id            String  @id @default(uuid())
  salesOrderId  String
  productId     String?
  productName   String
  model         String?
  quality       String?
  variant       String?
  quantity      Int
  unitPrice     Float
  discount      Float   @default(0.0)
  total         Float

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model DeliveryChallan {
  id            String   @id @default(uuid())
  businessId    String
  locationId    String?
  challanNo     String
  customerId    String?
  customerName  String
  customerPhone String?
  challanDate   DateTime @default(now())
  vehicleNo     String?
  transport     String?
  notes         String?
  status        String   @default("DELIVERED") // DELIVERED, BILLED, RETURNED
  createdAt     DateTime @default(now())

  items DeliveryChallanItem[]
}

model DeliveryChallanItem {
  id                String @id @default(uuid())
  deliveryChallanId String
  productId         String?
  productName       String
  quantity          Int

  deliveryChallan DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  businessId    String
  locationId    String?
  poNo          String
  supplierId    String?
  supplierName  String
  poDate        DateTime @default(now())
  expectedDate  DateTime?
  subtotal      Float
  total         Float
  status        String   @default("ORDERED") // ORDERED, RECEIVED, PARTIAL, CANCELLED
  notes         String?
  createdAt     DateTime @default(now())

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  productId        String?
  productName      String
  quantity         Int
  receivedQuantity Int     @default(0)
  unitPrice        Float
  total            Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

